# Environment Variables Template for backend-core
# Copy this file to .env and fill in real values

# Database
DB_URL=jdbc:postgresql://localhost:5433/dapcode_db
DB_USERNAME=postgres
DB_PASSWORD=123123

# CORS (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Auth & Security
JWT_SECRET=your_jwt_secret_base64_256bit
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth2 Frontend Callback Redirect URI
OAUTH2_REDIRECT_URI=http://localhost:5173/auth/callback

# Default Admin Account (Initialized on startup if not present or password unhashed)
ADMIN_DEFAULT_USERNAME=dapcode_admin
ADMIN_DEFAULT_EMAIL=admin@dapcode.io
ADMIN_DEFAULT_PASSWORD=admin123
